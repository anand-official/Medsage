{
  "name": "medsage-backend",
  "version": "1.0.0",
  "description": "AI-powered medical study companion backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "next start -p 3000",
    "dev:backend": "nodemon server/index.js",
    "start:frontend": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "build:next": "next build --webpack",
    "migrate:mongo-export": "node server/scripts/import_mongo_export_to_supabase.js",
    "verify:supabase-security": "node server/scripts/verify_supabase_security.js",
    "verify:supabase-schema": "node server/scripts/verify_supabase_schema.js",
    "rag:dry-run": "node server/scripts/rag_probe.js",
    "rag:auto-ingest": "node server/scripts/rag_auto_ingest.js",
    "test:backend": "jest --config jest.backend.config.js --runInBand",
    "test:frontend": "jest --config jest.frontend.config.js --runInBand"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/material-nextjs": "^9.0.0",
    "@mui/system": "^7.3.10",
    "@mui/types": "^7.4.12",
    "@mui/utils": "^7.3.10",
    "@mui/x-date-pickers": "^8.27.2",
    "@qdrant/js-client-rest": "^1.17.0",
    "@react-oauth/google": "^0.13.5",
    "@supabase/supabase-js": "^2.105.1",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.15.2",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.2",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "js-tiktoken": "^1.0.21",
    "lodash.debounce": "^4.0.8",
    "morgan": "^1.10.1",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "24.x"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
