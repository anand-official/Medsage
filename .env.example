# ─────────────────────────────────────────────
# MedSage Frontend — Environment Variables
# Copy to .env.local for local development.
# Set these in Vercel Dashboard → Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────

# Optional: override the backend API base URL.
# Leave UNSET on Vercel — the Next.js rewrites in next.config.js proxy /api/* to Render automatically.
# Set for local dev only if your backend runs on a non-standard port.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: public build SHA shown in the System Status diagnostics panel.
# Set automatically by CI/CD pipelines (e.g. VERCEL_GIT_COMMIT_SHA on Vercel).
# NEXT_PUBLIC_BUILD_SHA=abc1234
