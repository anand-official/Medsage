# ─────────────────────────────────────────────
# Cortex (MedSage AI Assistant) Backend — Environment Variables
# Copy this file to server/.env and fill in real values
# NEVER commit server/.env to git
# ─────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development
DATABASE_PROVIDER=supabase

# Supabase (required for the Postgres data layer)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key_here
SUPABASE_SECRET_KEY=sb_secret_your_server_secret_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PLANNER_GEMINI_API_KEY=your_planner_specific_gemini_api_key_here
PLANNER_GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# HuggingFace (for embeddings)
HF_API_TOKEN=your_huggingface_api_token_here
HF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Qdrant Vector DB (use Qdrant Cloud for production: https://cloud.qdrant.io)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_using_cloud

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://medsage.ai,https://www.medsage.ai

# Cortex Confidence Engine Weights (must sum to 1.0)
CONF_WEIGHT_TOPIC=0.4
CONF_WEIGHT_RETRIEVAL=0.4
CONF_WEIGHT_CITATION=0.2

# Cortex Query Cache (in-process, no Redis required)
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Learner context cache TTL (seconds, independent of query cache)
# How long per-user profile/study-plan data is cached before re-fetching.
# Default: 300 (5 minutes). Keep low so profile changes propagate quickly.
LEARNER_CACHE_TTL_SECONDS=300

# Cortex Fallback LLM (used when Gemini is unavailable)
# Provider: 'claude' (Anthropic) or 'openai' (OpenAI GPT-4o-mini)
FALLBACK_LLM_PROVIDER=claude
FALLBACK_LLM_API_KEY=your_fallback_api_key_here
